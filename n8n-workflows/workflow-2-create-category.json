      "id": "a2000001-0001-4000-8000-000000000004",
      "name": "HTTP Request - Create Category",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 200],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "WooCommerce API Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Format the WooCommerce response after category creation.\n// Handle success, duplicate (term_exists), and other errors.\n\nconst items = $input.all();\nconst data = items[0]?.json || {};\n\n// Successful creation — WooCommerce returns the new category object\nif (data.id && data.name) {\n  return [{\n    json: {\n      success: true,\n      category: {\n        id: data.id,\n        name: data.name,\n        parent: data.parent || 0\n      }\n    }\n  }];\n}\n\n// WooCommerce error: category already exists\nif (data.code === 'term_exists') {\n  return [{\n    json: {\n      success: false,\n      message: 'A category with this name already exists.',\n      existing_id: data.data?.resource_id || null\n    }\n  }];\n}\n\n// Other error\nreturn [{\n  json: {\n    success: false,\n    message: data.message || 'Failed to create category.'\n  }\n}];\n"
      },
      "id": "a2000001-0001-4000-8000-000000000005",
