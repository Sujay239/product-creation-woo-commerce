    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Validate the incoming request body for category creation.\n// Requires: name (string)\n// Optional: parent (integer, defaults to 0)\n\nconst items = $input.all();\nconst body = items[0]?.json?.body || items[0]?.json || {};\n\nconst name = (body.name || '').trim();\nconst parent = parseInt(body.parent) || 0;\n\nif (!name) {\n  return [{\n    json: {\n      _valid: false,\n      _error: {\n        success: false,\n        message: 'Category name is required.'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    _valid: true,\n    name: name,\n    parent: parent\n  }\n}];\n"
      },
      "id": "a2000001-0001-4000-8000-000000000002",
      "name": "Code - Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
