    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Format the WooCommerce categories response into a clean structure\n// that the frontend can directly consume.\n\nconst inputItems = $input.all();\n\ntry {\n  // The HTTP Request node returns the raw WooCommerce response.\n  // If it's an array, it contains the categories.\n  // If it's an error, we handle it gracefully.\n  \n  let rawData = inputItems[0]?.json;\n  \n  // Check if the response is an array (successful response)\n  // When HTTP Request returns the response directly, the first item's json\n  // contains the response body. For arrays, n8n may split into items.\n  let categories = [];\n  \n  if (Array.isArray(rawData)) {\n    categories = rawData;\n  } else if (inputItems.length > 1 || (rawData && rawData.id)) {\n    // n8n splits array responses into separate items\n    categories = inputItems.map(item => item.json);\n  }\n  \n  // Map to clean format: { id, name, parent }\n  const cleanCategories = categories\n    .filter(cat => cat && cat.id)\n    .map(cat => ({\n      id: cat.id,\n      name: cat.name || '',\n      parent: cat.parent || 0\n    }));\n  \n  return [{\n    json: {\n      success: true,\n      categories: cleanCategories\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      success: false,\n      message: 'Failed to fetch categories: ' + error.message,\n      categories: []\n    }\n  }];\n}\n"
      },
